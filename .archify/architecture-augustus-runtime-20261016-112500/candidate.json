  "cards": [
    {
      "dot": "cyan",
      "title": "สถาปัตยกรรมระดับรันไทม์ (Runtime Architecture)",
      "items": [
        "โครงสร้างแบบ Hybrid Two-Tier: Flutter Framework ทำหน้าที่เป็น UI Shell & Event Host และ Flame Engine ทำหน้าที่เป็น Real-time Game Loop",
        "รันไทม์ควบคุมด้วย FixedResolutionViewport ขนาด 800x600 สไตล์เรโทรเพื่อล็อกอัตราส่วนการแสดงผลให้เท่ากันทุกแพลตฟอร์ม (Desktop, Web, Mobile)",
        "การจัดส่งคีย์บอร์ดและทัชสกรีนถูกแยกระหว่าง Flutter UI Overlay (VirtualControls/HudOverlay) และ Flame KeyboardEvents โดยไม่รบกวนการคำนวณฟิสิกส์"
      ]
    },
    {
      "dot": "emerald",
      "title": "เส้นทางหลักและการควบคุม (Primary Route & Physics)",
      "items": [
        "เส้นทางหลัก (Primary Path: สีเขียวเน้น): User Input -> Screen Navigator -> Flame Core -> Player Controller -> Collision Combat",
        "กลไกฟิสิกส์จำลอง The Kid (Masocore Physics) แบบไร้แรงเฉื่อย (Zero Inertia Movement) ตอบสนองทันที 0ms เมื่อหยุดเดิน",
        "ระบบกระโดดรองรับ Variable Jump (ตัดความสูงลงเมื่อปล่อยปุ่มเร็ว) และ Double Jump กลางอากาศ พร้อม Coyote Time (100ms) และ Jump Buffer (120ms)",
        "Sub-step Physics: เมื่อเฟรมเรตตก (dt > 16ms) ระบบจะแบ่งการคำนวณเป็น half-step เพื่อป้องกันปัญหาวัตถุทะลุผ่าน (Tunneling)"
      ]
    },
    {
      "dot": "rose",
      "title": "ระบบกับดักและวงจรมรณะ (Hazards & Trap Automation)",
      "items": [
        "กับดักแบบ Handcrafted Fixed Traps ทั้ง 3 ด่าน (Orchard, Spikes, Leap) ควบคุมด้วย TriggerZone และ HazardBase",
        "กับดักแอปเปิ้ลและหนามกิโยตินหลอกตา (Deceptive Traps) เคลื่อนที่ย้อนศรและเปลี่ยนวิถีตามตำแหน่งตัวละคร",
        "การตายของผู้เล่น (Player.die) ก่อให้เกิด BloodParticleSystem สุ่มทิศทางละอองเลือดรอบจุดตายแบบ Custom Canvas Render"
      ]
    },
    {
      "dot": "amber",
      "title": "จุดเซฟและการเกิดใหม่ทันที (Checkpoint & 0s Respawn)",
      "items": [
        "SavePoint บันทึกพิกัดเมื่อถูกกระสุน (Bullet) ชนเท่านั้น โดยจะเปลี่ยนสถานะจาก SAVE เป็น SAVED พร้อมบันทึกพิกัดลง activeCheckpoint",
        "Zero-Delay Quick Respawn (กด R หรือแตะจอขณะตาย) รีเซ็ตพิกัดตัวละครไปยังจุดเซฟล่าสุดและสั่ง resetHazards() ใน 0 วินาทีโดยไม่ต้องโหลดหน้าจอใหม่"
      ]
    },
    {
      "dot": "violet",
      "title": "การพึ่งพาภายนอกและขอบเขตความเชื่อถือ (Dependencies & Trust Boundaries)",
      "items": [
        "ขอบเขตภายนอก (Untrusted Client Device): รับสัญญาณ Raw Input จาก Hardware Keyboard และ Touch Digitizer ผ่าน OS Driver",
        "ขอบเขต Flutter UI Host (Trust Zone 1): ควบคุมความปลอดภัยของหน้าจอ เมนู การสลับด่าน และ System Navigation",
        "ขอบเขต Flame Game Simulation (Trust Zone 2): เป็นแซนด์บ็อกซ์สำหรับ State ของเกมทั้งหมด วัตถุกายภาพ กับดัก และสถานะการเกิดใหม่",
        "การพึ่งพาภายนอก: Flutter SDK (Widgets, SystemChrome) และ Flame Engine v1.18.0 (Camera, Viewport, CollisionDetection)"
      ]
    }
  ]
}
